# Dashboard build-time configuration - copy to client/.env.local if needed.
# Vite inlines these at build time.

# API origin including scheme, no trailing slash. Empty = same origin.
# Split deployment example: https://openremote.onrender.com
VITE_API_URL=

# Socket.IO origin. Empty = same origin (the page's own origin).
# Split deployment example: https://openremote.onrender.com
VITE_SERVER_URL=
