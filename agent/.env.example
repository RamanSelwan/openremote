# Agent configuration - copy to agent/.env
# These names MUST match agent/src/config.js (loadConfig()).

# Relay server. Production example: https://openremote.onrender.com
SERVER_URL=http://localhost:5000

# One-time pairing code (alternative to: npm run pair -- --code XXXX-XXXX)
# ENROLL_CODE=

# Provision an existing device without a pairing code (advanced).
# DEVICE_TOKEN=
# DEVICE_ID=

# Friendly device name shown in the dashboard (defaults to the hostname).
DEVICE_NAME=My PC

# Consent: "approve" asks the operator each time, "open" allows anyone.
ACCESS_MODE=approve

# 1 = auto-approve requests while in "approve" mode (no console prompt).
AUTO_ACCEPT=1

# 0 = view-only, input events are ignored.
ALLOW_CONTROL=1

# Stream defaults (the viewer can override these live).
FPS=15
SCALE=0.65
QUALITY=55

# Drivers: auto | ffmpeg | robotjs | screenshot-desktop | powershell | synthetic
# "auto" prefers ffmpeg (GPU capture + hardware MJPEG) and silently falls back
# to robotjs when ffmpeg is missing or the hardware path is unavailable.
CAPTURE_DRIVER=auto

# ffmpeg capture (CAPTURE_DRIVER=ffmpeg or auto). Requires ffmpeg >= 6.0 with
# the ddagrab filter; install with: winget install Gyan.FFmpeg
# FFMPEG_PATH=ffmpeg
# Force a specific capture source / encoder instead of probing:
# FFMPEG_INPUT=auto          # auto | ddagrab | gdigrab
# FFMPEG_ENCODER=auto        # auto | mjpeg_qsv | mjpeg

# Drivers: auto | robotjs | powershell | dry-run
INPUT_DRIVER=auto

# Override the device-credentials location (default: agent/data/device.json).
# AGENT_DATA_DIR=
