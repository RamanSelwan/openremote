# Agent configuration
# Server URL (Render/Vercel proxy or Render directly)
AGENT_SERVER_URL=http://localhost:5000

# Device token (auto-filled when using `npm run pair -- --code ...`)
# AGENT_DEVICE_TOKEN=...

# Friendly device name
AGENT_NAME=My PC

# Access mode: open | approve (set in server/device or via ACCESS_MODE env)
ACCESS_MODE=open

# Capture tuning (ms, 0.2-1.0 scale, 20-90 quality, 1-30 fps)
CAPTURE_INTERVAL_MS=120
CAPTURE_SCALE=0.65
CAPTURE_QUALITY=55
CAPTURE_FPS=10
CAPTURE_MAX_WIDTH=1920
CAPTURE_MAX_HEIGHT=1080
