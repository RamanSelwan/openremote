# Server configuration
NODE_ENV=development
PORT=5000

# MongoDB
# In production, set to Atlas URI (required)
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/openremote

# Auth
# In production, use a long random secret (required)
JWT_SECRET=change-me-in-dev-only
JWT_TTL=7d

# CORS / Socket.IO allowlist (comma-separated)
# For Vercel+Render split, set to your Vercel URL in production
CLIENT_ORIGIN=http://localhost:5173

# Trust proxy (Render/Heroku/Nginx behind proxy)
# Set to 1 in production behind a reverse proxy
TRUST_PROXY=0

# Pairing-code lifetime in minutes
ENROLL_CODE_TTL_MINUTES=10
